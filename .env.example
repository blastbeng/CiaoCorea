# Copia in .env per lo sviluppo locale. Il .env non va mai committato.
# In produzione i valori arrivano da /opt/docker/compose/.secrets/ciaocorea.env

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
WEB_DIST=apps/web/dist

# Cookie di sessione: 1 solo dietro HTTPS
COOKIE_SECURE=0
SESSION_DAYS=30

# Difesa contro tentativi di login a raffica
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Iscrizioni: closed (solo CLI), invite (serve un codice), open (nessun codice).
# Con invite i codici si creano con: npm run accounts -- invite:new
REGISTRATION_MODE=closed
# Codice "madre" d'emergenza, per il primo account quando non ci sono inviti.
REGISTRATION_CODE=

# Account creato al primo avvio se il database è vuoto.
# La password non si committa: mettila solo nel .env locale o nei secrets.
SEED_USER_EMAIL=blast
SEED_USER_PASSWORD=
SEED_USER_NAME=Blast
